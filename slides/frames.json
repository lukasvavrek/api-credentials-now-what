  {
    "id": "s6-chat-def",
    "lines": [
      [
        "cmd",
        "chat() {"
      ],
      [
        "cont",
        "  curl -s https://api.anthropic.com/v1/messages \\"
      ],
      [
        "cont",
        "    -H \"x-api-key: $ANTHROPIC_API_KEY\" \\"
      ],
      [
        "cont",
        "    -H \"anthropic-version: 2023-06-01\" \\"
      ],
      [
        "cont",
        "    -d \"{\\\"model\\\": \\\"$MODEL\\\", \\\"max_tokens\\\": 256, \\\"messages\\\": $1}\" \\"
      ],
      [
        "cont",
        "    | jq -r '.content[] | select(.type==\"text\") | .text'"
      ],
      [
        "cont",
        "}"
      ]
    ]
  },
